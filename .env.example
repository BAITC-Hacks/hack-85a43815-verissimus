# Optional: only needed for the natural-language chat, not batch or the forecast button.
# Copy this file to .env and supply your own key locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# SCADA timezone is NOT specified by organizers. Default assumption: Asia/Almaty.
# To override consistently for UI and CLI, set SCADA_TIMEZONE in the shell environment.
# Power remains in the original normalized dimensionless scale. No MW rating is assumed.
